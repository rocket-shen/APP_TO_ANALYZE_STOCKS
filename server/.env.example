# Optional — copy to .env; omit .env to use code defaults.
ENV=dev

# Paths (optional; relative to server/)
DB_PATH=./data/financial.db
DEFAULT_EXPORT_DIR=./data/exports
STOCK_DICT_A_PATH=./data/stock_dict_a.npy

TIMEOUT=15

# --- Single-user cookie login ---
# When AUTH_PASSWORD is empty and ENV=dev, login is optional (local convenience).
# When AUTH_PASSWORD is set, all query/sync/export routes require a session cookie.
# AUTH_SECRET is required whenever AUTH_PASSWORD is set (signs the HttpOnly cookie).
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
# Cookie: stocks_session, HttpOnly, SameSite=Lax, Secure when ENV!=dev, max-age 7d
# Same-origin deploy (nginx serving UI + /api): no CORS/cookie changes needed.

# API key / rate limit for POST /api/v1/sync_financial_data/* and GET /api/v1/export-excel/*
# Kept as a secondary layer (e.g. nginx injects X-API-Key). Login is still required when AUTH_PASSWORD is set.
# Empty API_KEY is allowed only when ENV=dev (no X-API-Key required).
API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Must be a JSON array (not comma-separated) for pydantic Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
